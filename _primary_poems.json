[
 {
  "title": "詠鵝",
  "author": "駱賓王",
  "dynasty": "唐",
  "grade": "一年級",
  "paragraphs": [
   "鵝，",
   "鵝，",
   "鵝，",
   "曲項向天歌。",
   "白毛浮綠水，",
   "紅掌撥清波。"
  ],
  "paraphrase": "七岁咏白鹅戏水，生动可爱"
 },
 {
  "title": "江南",
  "author": "漢樂府",
  "dynasty": "漢",
  "grade": "一年級",
  "paragraphs": [
   "江南可採蓮，蓮葉何田田。",
   "魚戲蓮葉間。",
   "魚戲蓮葉東，魚戲蓮葉西，魚戲蓮葉南，魚戲蓮葉北。"
  ],
  "paraphrase": "采莲诗中写鱼戏莲叶，欢快明朗"
 },
 {
  "title": "畫",
  "author": "王維",
  "dynasty": "唐",
  "grade": "一年級",
  "paragraphs": [
   "遠看山有色，近聽水無聲。",
   "春去花還在，人來鳥不驚。"
  ],
  "paraphrase": "谜语诗，写画中山水花鸟如真"
 },
 {
  "title": "憫農(其二)",
  "author": "李紳",
  "dynasty": "唐",
  "grade": "一年級",
  "paragraphs": [
   "鋤禾日當午，",
   "汗滴禾下土。",
   "誰知盤中餐，",
   "粒粒皆辛苦。"
  ],
  "paraphrase": "写农民耕作辛苦，劝人惜粮"
 },
 {
  "title": "古朗月行(節選)",
  "author": "李白",
  "dynasty": "唐",
  "grade": "一年級",
  "paragraphs": [
   "小時不識月，呼作白玉盤。",
   "又疑瑤臺鏡，飛在青雲端。"
  ],
  "paraphrase": "以白玉盘喻月，童趣盎然"
 },
 {
  "title": "風",
  "author": "李嶠",
  "dynasty": "唐",
  "grade": "一年級",
  "paragraphs": [
   "解落三秋葉，",
   "能開二月花。",
   "過江千尺浪，",
   "入竹萬竿斜。"
  ],
  "paraphrase": "写风之力量，无形而有功"
 },
 {
  "title": "春曉",
  "author": "孟浩然",
  "dynasty": "唐",
  "grade": "一年級",
  "paragraphs": [
   "春眠不覺曉，",
   "處處聞啼鳥。",
   "夜來風雨聲，",
   "花落知多少。"
  ],
  "paraphrase": "春日酣眠，怜惜落花"
 },
 {
  "title": "贈汪倫",
  "author": "李白",
  "dynasty": "唐",
  "grade": "一年級",
  "paragraphs": [
   "李白乘舟將欲行，",
   "忽聞岸上踏歌聲。",
   "桃花潭水深千尺，",
   "不及汪倫送我情。"
  ],
  "paraphrase": "汪伦踏歌送别，友情深厚"
 },
 {
  "title": "靜夜思",
  "author": "李白",
  "dynasty": "唐",
  "grade": "一年級",
  "paragraphs": [
   "床前明月光，疑是地上霜。",
   "舉頭望明月，低頭思故鄉。"
  ],
  "paraphrase": "月夜思乡，脍炙人口"
 },
 {
  "title": "尋隱者不遇",
  "author": "賈島",
  "dynasty": "唐",
  "grade": "一年級",
  "paragraphs": [
   "松下問童子，",
   "言師採藥去。",
   "只在此山中，",
   "雲深不知處。"
  ],
  "paraphrase": "寻隐不遇，唯闻云深不知处"
 },
 {
  "title": "池上",
  "author": "白居易",
  "dynasty": "唐",
  "grade": "一年級",
  "paragraphs": [
   "小娃撐小艇，",
   "偷採白蓮迴。",
   "不解藏踪跡，",
   "浮萍一道開。"
  ],
  "paraphrase": "小娃偷采白莲，天真可爱"
 },
 {
  "title": "小池",
  "author": "楊萬里",
  "dynasty": "宋",
  "grade": "一年級",
  "paragraphs": [
   "泉眼無聲惜細流，",
   "樹陰照水愛晴柔。",
   "小荷纔露尖尖角，",
   "早有蜻蜓立上頭。"
  ],
  "paraphrase": "初夏小池，小荷才露尖尖角"
 },
 {
  "title": "畫雞",
  "author": "唐寅",
  "dynasty": "明",
  "grade": "一年級",
  "paragraphs": [
   "頭上紅冠不用裁，滿身雪白走將來。",
   "平生不敢輕言語，一叫千門萬戶開。"
  ],
  "paraphrase": "写雄鸡一声千门万户开"
 },
 {
  "title": "梅花",
  "author": "王安石",
  "dynasty": "宋",
  "grade": "二年級",
  "paragraphs": [
   "牆角數枝梅，",
   "凌寒獨自開。",
   "遥知不是雪，",
   "爲有暗香來。"
  ],
  "paraphrase": "咏梅凌寒暗香，品格高洁"
 },
 {
  "title": "小兒垂釣",
  "author": "胡令能",
  "dynasty": "唐",
  "grade": "二年級",
  "paragraphs": [
   "蓬頭稚子學垂綸，",
   "側坐莓苔草映身。",
   "路人借問遙招手，",
   "怕得魚驚不應人。"
  ],
  "paraphrase": "学钓童怕鱼惊，稚气十足"
 },
 {
  "title": "登鸛雀樓",
  "author": "王之渙",
  "dynasty": "唐",
  "grade": "二年級",
  "paragraphs": [
   "白日依山盡，",
   "黃河入海流。",
   "欲窮千里目，",
   "更上一層樓。"
  ],
  "paraphrase": "登高望远，寓进取之理"
 },
 {
  "title": "望廬山瀑布",
  "author": "李白",
  "dynasty": "唐",
  "grade": "二年級",
  "paragraphs": [
   "日照香爐生紫煙，",
   "遙看瀑布挂前川。",
   "飛流直下三千尺，",
   "疑是銀河落九天。"
  ],
  "paraphrase": "写瀑布雄奇，疑是银河落九天"
 },
 {
  "title": "江雪",
  "author": "柳宗元",
  "dynasty": "唐",
  "grade": "二年級",
  "paragraphs": [
   "千山鳥飛絕，",
   "萬逕人蹤滅。",
   "孤舟蓑笠翁，",
   "獨釣寒江雪。"
  ],
  "paraphrase": "雪中独钓，孤高清绝"
 },
 {
  "title": "夜宿山寺",
  "author": "李白",
  "dynasty": "唐",
  "grade": "二年級",
  "paragraphs": [
   "危樓高百尺，",
   "手可摘星辰。",
   "不敢高聲語，",
   "恐驚天上人。"
  ],
  "paraphrase": "写楼高可摘星辰，夸张奇想"
 },
 {
  "title": "敕勒歌",
  "author": "北朝民歌",
  "dynasty": "北朝",
  "grade": "二年級",
  "paragraphs": [
   "敕勒川，陰山下。",
   "天似穹廬，籠蓋四野。",
   "天蒼蒼，野茫茫，風吹草低見牛羊。"
  ],
  "paraphrase": "草原苍茫，风吹草低见牛羊"
 },
 {
  "title": "村居",
  "author": "高鼎",
  "dynasty": "清",
  "grade": "二年級",
  "paragraphs": [
   "草長鶯飛二月天，拂堤楊柳醉春煙。",
   "兒童散學歸來早，忙趁東風放紙鳶。"
  ],
  "paraphrase": "春日儿童放纸鸢，生机盎然"
 },
 {
  "title": "詠柳",
  "author": "賀知章",
  "dynasty": "唐",
  "grade": "二年級",
  "paragraphs": [
   "碧玉妝成一樹高，",
   "萬條垂下綠絲縧。",
   "不知細葉誰裁出，",
   "二月春風似剪刀。"
  ],
  "paraphrase": "以剪刀喻春风，咏柳新绿"
 },
 {
  "title": "賦得古原草送別(節選)",
  "author": "白居易",
  "dynasty": "唐",
  "grade": "二年級",
  "paragraphs": [
   "離離原上草，一歲一枯榮。",
   "野火燒不盡，春風吹又生。"
  ],
  "paraphrase": "咏草顽强，兼送别之情"
 },
 {
  "title": "曉出淨慈寺送林子方",
  "author": "楊萬里",
  "dynasty": "宋",
  "grade": "二年級",
  "paragraphs": [
   "畢竟西湖六月中，",
   "風光不與四時同。",
   "接天蓮葉無窮碧，",
   "映日荷花別樣紅。"
  ],
  "paraphrase": "西湖六月荷花生机盎然"
 },
 {
  "title": "絕句(兩個黃鸝)",
  "author": "杜甫",
  "dynasty": "唐",
  "grade": "二年級",
  "paragraphs": [
   "兩個黃鸝鳴翠柳，一行白鷺上青天。",
   "窗含西嶺千秋雪，門泊東吳萬里船。"
  ],
  "paraphrase": "草堂春景，色彩明丽"
 },
 {
  "title": "憫農(其一)",
  "author": "李紳",
  "dynasty": "唐",
  "grade": "二年級",
  "paragraphs": [
   "春種一粒粟，",
   "秋成萬顆子。",
   "四海無閑田，",
   "農夫猶餓死。"
  ],
  "paraphrase": "写农夫犹饿死，揭露不公"
 },
 {
  "title": "舟夜書所見",
  "author": "查慎行",
  "dynasty": "清",
  "grade": "二年級",
  "paragraphs": [
   "月黑見漁燈，孤光一點螢。",
   "微微風簇浪，散作滿河星。"
  ],
  "paraphrase": "河上渔灯散作满河星"
 },
 {
  "title": "所見",
  "author": "袁枚",
  "dynasty": "清",
  "grade": "三年級",
  "paragraphs": [
   "牧童騎黃牛，歌聲振林樾。",
   "意欲捕鳴蟬，忽然閉口立。"
  ],
  "paraphrase": "牧童欲捕蝉，忽然闭口立"
 },
 {
  "title": "山行",
  "author": "杜牧",
  "dynasty": "唐",
  "grade": "三年級",
  "paragraphs": [
   "遠上寒山石徑斜，",
   "白雲生處有人家。",
   "停車坐愛楓林晚，",
   "霜葉紅於二月花。"
  ],
  "paraphrase": "秋山红叶，停车赏枫"
 },
 {
  "title": "贈劉景文",
  "author": "蘇軾",
  "dynasty": "宋",
  "grade": "三年級",
  "paragraphs": [
   "荷盡已無擎雨蓋，",
   "菊殘猶有傲霜枝。",
   "一年好景君須記，",
   "正是橙黄橘綠時。"
  ],
  "paraphrase": "赠友，赞橙黄橘绿好景"
 },
 {
  "title": "夜書所見",
  "author": "葉紹翁",
  "dynasty": "宋",
  "grade": "三年級",
  "paragraphs": [
   "蕭蕭梧葉送寒聲，",
   "江上秋風動客情。",
   "知有兒童挑促織，",
   "夜深籬落一燈明。"
  ],
  "paraphrase": "秋夜客中思乡"
 },
 {
  "title": "望天門山",
  "author": "李白",
  "dynasty": "唐",
  "grade": "三年級",
  "paragraphs": [
   "天門中斷楚江開，",
   "碧水東流至北迴。",
   "兩岸青山相對出，",
   "孤帆一片日邊來。"
  ],
  "paraphrase": "长江冲破天门，气势奔放"
 },
 {
  "title": "飲湖上初晴後雨",
  "author": "蘇軾",
  "dynasty": "宋",
  "grade": "三年級",
  "paragraphs": [
   "水光瀲灩晴方好，山色空濛雨亦奇。",
   "欲把西湖比西子，淡妝濃抹總相宜。"
  ],
  "paraphrase": "西湖晴雨皆美，比西子"
 },
 {
  "title": "望洞庭",
  "author": "劉禹錫",
  "dynasty": "唐",
  "grade": "三年級",
  "paragraphs": [
   "湖光秋月兩相和，",
   "潭面無風鏡未磨。",
   "遙望洞庭山水翠，",
   "白銀盤裏一青螺。"
  ],
  "paraphrase": "洞庭如白银盘里青螺"
 },
 {
  "title": "早發白帝城",
  "author": "李白",
  "dynasty": "唐",
  "grade": "三年級",
  "paragraphs": [
   "朝辭白帝彩雲間，",
   "千里江陵一日還。",
   "兩岸猨聲啼不盡，",
   "輕舟已過萬重山。"
  ],
  "paraphrase": "遇赦东归，轻舟已过万重山"
 },
 {
  "title": "採蓮曲",
  "author": "王昌齡",
  "dynasty": "唐",
  "grade": "三年級",
  "paragraphs": [
   "荷葉羅裙一色裁，",
   "芙蓉向臉兩邊開。",
   "亂入池中看不見，",
   "聞歌始覺有人來。"
  ],
  "paraphrase": "采莲女与荷融为一色"
 },
 {
  "title": "絕句(遲日江山麗)",
  "author": "杜甫",
  "dynasty": "唐",
  "grade": "三年級",
  "paragraphs": [
   "遲日江山麗，",
   "春風花草香。",
   "泥融飛燕子，",
   "沙暖睡鴛鴦。"
  ],
  "paraphrase": "春日江山，燕鸳安适"
 },
 {
  "title": "惠崇春江晚景",
  "author": "蘇軾",
  "dynasty": "宋",
  "grade": "三年級",
  "paragraphs": [
   "竹外桃花三兩枝，",
   "春江水暖鴨先知。",
   "蔞蒿滿地蘆芽短，",
   "正是河豚欲上時。"
  ],
  "paraphrase": "题画诗，鸭知水暖"
 },
 {
  "title": "三衢道中",
  "author": "曾幾",
  "dynasty": "宋",
  "grade": "三年級",
  "paragraphs": [
   "梅子黃時日日晴，小溪泛盡卻山行。",
   "綠陰不減來時路，添得黃鸝四五聲。"
  ],
  "paraphrase": "初夏山行，添黄鹂声"
 },
 {
  "title": "憶江南",
  "author": "白居易",
  "dynasty": "唐",
  "grade": "三年級",
  "paragraphs": [
   "江南好，",
   "風景舊曾諳。"
  ],
  "paraphrase": "忆江南江花红胜火江水绿如蓝"
 },
 {
  "title": "元日",
  "author": "王安石",
  "dynasty": "宋",
  "grade": "三年級",
  "paragraphs": [
   "爆竹聲中一歲除，",
   "東風送暖入屠蘇。",
   "千門萬戶曈曈日，",
   "爭插新桃換舊符。"
  ],
  "paraphrase": "写春节除旧迎新"
 },
 {
  "title": "清明",
  "author": "杜牧",
  "dynasty": "唐",
  "grade": "三年級",
  "paragraphs": [
   "清明時節雨紛紛，路上行人欲斷魂。",
   "借問酒家何處有？牧童遙指杏花村。"
  ],
  "paraphrase": "清明路上借问酒家"
 },
 {
  "title": "九月九日憶山東兄弟",
  "author": "王維",
  "dynasty": "唐",
  "grade": "三年級",
  "paragraphs": [
   "獨在異鄉為異客，",
   "每逢佳節倍思親。",
   "遙知兄弟登高處，",
   "遍插茱萸少一人。"
  ],
  "paraphrase": "重阳思亲，遥想登高"
 },
 {
  "title": "滁州西澗",
  "author": "韋應物",
  "dynasty": "唐",
  "grade": "三年級",
  "paragraphs": [
   "獨憐幽草澗邊生，",
   "上有黃鸝深樹鳴。",
   "春潮帶雨晚來急，",
   "野渡無人舟自橫。"
  ],
  "paraphrase": "涧边幽草，野渡无人"
 },
 {
  "title": "大林寺桃花",
  "author": "白居易",
  "dynasty": "唐",
  "grade": "三年級",
  "paragraphs": [
   "人間四月芳菲盡，",
   "山寺桃花始盛開。",
   "長恨春歸無覓處，",
   "不知轉入此中來。"
  ],
  "paraphrase": "山寺桃花晚开，别有洞天"
 },
 {
  "title": "浪淘沙(其七)",
  "author": "劉禹錫",
  "dynasty": "唐",
  "grade": "四年級",
  "paragraphs": [
   "八月濤聲吼地來，",
   "頭高數丈觸山回。",
   "須臾却入海門去，",
   "卷起沙堆似雪堆。"
  ],
  "paraphrase": "写钱塘江潮气势"
 },
 {
  "title": "鹿柴",
  "author": "王維",
  "dynasty": "唐",
  "grade": "四年級",
  "paragraphs": [
   "空山不見人，",
   "但聞人語響。",
   "返景入深林，",
   "復照青苔上。"
  ],
  "paraphrase": "空山人语响，返景入深林"
 },
 {
  "title": "暮江吟",
  "author": "白居易",
  "dynasty": "唐",
  "grade": "四年級",
  "paragraphs": [
   "一道殘陽鋪水中，",
   "半江瑟瑟半江紅。",
   "可憐九月初三夜，",
   "露似真珠月似弓。"
  ],
  "paraphrase": "暮江残阳露似真珠"
 },
 {
  "title": "題西林壁",
  "author": "蘇軾",
  "dynasty": "唐",
  "grade": "四年級",
  "paragraphs": [
   "橫看成嶺側成峰，",
   "遠近高低總不同。",
   "不識廬山真面目，",
   "只緣身在此山中。"
  ],
  "paraphrase": "庐山寓\"当局者迷\"之理"
 },
 {
  "title": "雪梅",
  "author": "盧鉞",
  "dynasty": "宋",
  "grade": "四年級",
  "paragraphs": [
   "梅雪爭春未肯降，",
   "騷人閣筆費平章。",
   "梅須遜雪三分白，",
   "雪却輸梅一段香。"
  ],
  "paraphrase": "梅雪各擅胜场"
 },
 {
  "title": "嫦娥",
  "author": "李商隱",
  "dynasty": "唐",
  "grade": "四年級",
  "paragraphs": [
   "雲母屏風燭影深，",
   "長河漸落曉星沈。",
   "常娥應悔偷靈藥，",
   "碧海青天夜夜心。"
  ],
  "paraphrase": "嫦娥悔偷灵药"
 },
 {
  "title": "出塞",
  "author": "王昌齡",
  "dynasty": "唐",
  "grade": "四年級",
  "paragraphs": [
   "秦時明月漢時關，",
   "萬里長征人未還。",
   "但使龍城飛將在，",
   "不教胡馬度陰山。"
  ],
  "paraphrase": "盼良将守边"
 },
 {
  "title": "涼州詞(葡萄美酒)",
  "author": "王翰",
  "dynasty": "唐",
  "grade": "四年級",
  "paragraphs": [
   "葡萄美酒夜光杯，",
   "欲飲琵琶馬上催。",
   "醉臥沙場君莫笑，",
   "古來征戰幾人回。"
  ],
  "paraphrase": "出征前醉卧沙场"
 },
 {
  "title": "夏日絕句",
  "author": "李清照",
  "dynasty": "宋",
  "grade": "四年級",
  "paragraphs": [
   "生當作人傑，死亦為鬼雄。",
   "至今思項羽，不肯過江東。"
  ],
  "paraphrase": "咏项羽，励人杰"
 },
 {
  "title": "別董大",
  "author": "高適",
  "dynasty": "唐",
  "grade": "四年級",
  "paragraphs": [
   "千里黃雲白日曛，北風吹雁雪紛紛。",
   "莫愁前路無知己，天下誰人不識君。"
  ],
  "paraphrase": "送别慰友，天下谁人不识君"
 },
 {
  "title": "四時田園雜興(其二十五)",
  "author": "范成大",
  "dynasty": "宋",
  "grade": "四年級",
  "paragraphs": [
   "梅子金黃杏子肥，麥花雪白菜花稀。",
   "日長籬落無人過，惟有蜻蜓蛺蝶飛。"
  ],
  "paraphrase": "初夏田园，蜓蝶飞舞"
 },
 {
  "title": "宿新市徐公店",
  "author": "楊萬里",
  "dynasty": "宋",
  "grade": "四年級",
  "paragraphs": [
   "籬落疏疏一徑深，樹頭新綠未成陰。",
   "兒童急走追黃蝶，飛入菜花無處尋。"
  ],
  "paraphrase": "篱落追黄蝶，童趣盎然"
 },
 {
  "title": "清平樂·村居",
  "author": "辛棄疾",
  "dynasty": "宋",
  "grade": "四年級",
  "paragraphs": [
   "茅簷低小，溪上青青草。",
   "醉裡吳音相媚好，白髮誰家翁媼？",
   "大兒鋤豆溪東，中兒正織雞籠。",
   "最喜小兒亡賴，溪頭臥剝蓮蓬。"
  ],
  "paraphrase": "农家老少，温馨闲适"
 },
 {
  "title": "江畔獨步尋花(其五)",
  "author": "杜甫",
  "dynasty": "唐",
  "grade": "四年級",
  "paragraphs": [
   "黃師塔前江水東，",
   "春光嬾困倚微風。",
   "桃花一簇開無主，",
   "可愛深紅愛淺紅。"
  ],
  "paraphrase": "桃花一簇，深红浅红"
 },
 {
  "title": "蜂",
  "author": "羅隱",
  "dynasty": "唐",
  "grade": "四年級",
  "paragraphs": [
   "不論平地與山尖，無限風光盡被佔。",
   "採得百花成蜜後，為誰辛苦為誰甜？"
  ],
  "paraphrase": "采蜜辛劳，为谁甜蜜"
 },
 {
  "title": "獨坐敬亭山",
  "author": "李白",
  "dynasty": "唐",
  "grade": "四年級",
  "paragraphs": [
   "眾鳥高飛盡，",
   "孤雲獨去閑。",
   "相看兩不厭，",
   "只有敬亭山。"
  ],
  "paraphrase": "相看两不厌，只有敬亭山"
 },
 {
  "title": "芙蓉樓送辛漸",
  "author": "王昌齡",
  "dynasty": "唐",
  "grade": "四年級",
  "paragraphs": [
   "寒雨連江夜入吳，平明送客楚山孤。",
   "洛陽親友如相問，一片冰心在玉壺。"
  ],
  "paraphrase": "送别，冰心玉壶"
 },
 {
  "title": "塞下曲",
  "author": "盧綸",
  "dynasty": "唐",
  "grade": "四年級",
  "paragraphs": [
   "月黑雁飛高，",
   "單于夜遁逃。",
   "欲將輕騎逐，",
   "大雪滿弓刀。"
  ],
  "paraphrase": "将军欲逐单于夜遁逃"
 },
 {
  "title": "墨梅",
  "author": "王冕",
  "dynasty": "元",
  "grade": "四年級",
  "paragraphs": [
   "我家洗硯池頭樹，朵朵花開淡墨痕。",
   "不要人誇好顏色，只留清氣滿乾坤。"
  ],
  "paraphrase": "咏梅只留清气满乾坤"
 },
 {
  "title": "蟬",
  "author": "虞世南",
  "dynasty": "唐",
  "grade": "五年級",
  "paragraphs": [
   "垂緌飲清露，",
   "流響出疎桐。",
   "居高聲自遠，",
   "非是藉秋風。"
  ],
  "paraphrase": "居高声自远，喻立身品格"
 },
 {
  "title": "乞巧",
  "author": "林傑",
  "dynasty": "唐",
  "grade": "五年級",
  "paragraphs": [
   "七夕今宵看碧霄，",
   "牽牛織女渡河橋。",
   "家家乞巧望秋月，",
   "穿盡紅絲幾萬條。"
  ],
  "paraphrase": "七夕乞巧望秋月"
 },
 {
  "title": "示兒",
  "author": "陸游",
  "dynasty": "宋",
  "grade": "五年級",
  "paragraphs": [
   "死去元知萬事空，",
   "但悲不見九州同。",
   "王師北定中原日，",
   "家祭無忘告乃翁。"
  ],
  "paraphrase": "临终盼收复，家祭告乃翁"
 },
 {
  "title": "題臨安邸",
  "author": "林昇",
  "dynasty": "宋",
  "grade": "五年級",
  "paragraphs": [
   "山外青山樓外樓，",
   "西湖歌舞幾時休。",
   "暖風薰得遊人醉，",
   "直把杭州作汴州。"
  ],
  "paraphrase": "讽南宋苟安"
 },
 {
  "title": "己亥雜詩",
  "author": "龔自珍",
  "dynasty": "清",
  "grade": "五年級",
  "paragraphs": [
   "九州生氣恃風雷，萬馬齊喑究可哀。",
   "我勸天公重抖擻，不拘一格降人材。"
  ],
  "paraphrase": "盼天公抖擞降人才"
 },
 {
  "title": "山居秋暝",
  "author": "王維",
  "dynasty": "唐",
  "grade": "五年級",
  "paragraphs": [
   "空山新雨後，",
   "天氣晚來秋。",
   "明月松間照，",
   "清泉石上流。",
   "竹喧歸浣女，",
   "蓮動下漁舟。",
   "隨意春芳歇，",
   "王孫自可留。"
  ],
  "paraphrase": "秋山清泉，王孙可留"
 },
 {
  "title": "楓橋夜泊",
  "author": "張繼",
  "dynasty": "唐",
  "grade": "五年級",
  "paragraphs": [
   "月落烏啼霜滿天，",
   "江楓漁父對愁眠。",
   "姑蘇城外寒山寺，",
   "夜半鐘聲到客船。"
  ],
  "paraphrase": "夜泊寒山寺，客愁难眠"
 },
 {
  "title": "長相思",
  "author": "納蘭性德",
  "dynasty": "清",
  "grade": "五年級",
  "paragraphs": [
   "山一程，水一程，身向榆關那畔行，夜深千帳燈。",
   "風一更，雪一更，聒碎鄉心夢不成，故園無此聲。"
  ],
  "paraphrase": "边塞思乡，夜深千帐灯"
 },
 {
  "title": "漁歌子",
  "author": "張志和",
  "dynasty": "唐",
  "grade": "五年級",
  "paragraphs": [
   "西塞山前白鷺飛，",
   "桃花流水鱖魚肥。",
   "青篛笠，",
   "綠簑衣，",
   "斜風細雨不須歸。"
  ],
  "paraphrase": "垂钓不须归，隐逸之乐"
 },
 {
  "title": "觀書有感(其一)",
  "author": "朱熹",
  "dynasty": "宋",
  "grade": "五年級",
  "paragraphs": [
   "半畝方塘一鑑開，",
   "天光雲影共徘徊。",
   "問渠那得清如許，",
   "爲有源頭活水來。"
  ],
  "paraphrase": "喻学习如活水"
 },
 {
  "title": "觀書有感(其二)",
  "author": "朱熹",
  "dynasty": "宋",
  "grade": "五年級",
  "paragraphs": [
   "昨夜江邊春水生，",
   "蒙衝巨艦一毛輕。",
   "向來枉費推移力，",
   "此日中流自在行。"
  ],
  "paraphrase": "喻功夫到自然成"
 },
 {
  "title": "四時田園雜興(其三十一)",
  "author": "范成大",
  "dynasty": "宋",
  "grade": "五年級",
  "paragraphs": [
   "晝出耘田夜績麻，",
   "村莊兒女各當家。",
   "童孫未解供耕織，",
   "也傍桑陰學種瓜。"
  ],
  "paraphrase": "村庄儿女各当家"
 },
 {
  "title": "稚子弄冰",
  "author": "楊萬里",
  "dynasty": "宋",
  "grade": "五年級",
  "paragraphs": [
   "稚子金盆脫曉冰，彩絲穿取當銀鉦。",
   "敲成玉磬穿林響，忽作玻璃碎地聲。"
  ],
  "paraphrase": "儿童弄冰作钲"
 },
 {
  "title": "村晚",
  "author": "雷震",
  "dynasty": "宋",
  "grade": "五年級",
  "paragraphs": [
   "草滿池塘水滿陂，山銜落日浸寒漪。",
   "牧童歸去橫牛背，短笛無腔信口吹。"
  ],
  "paraphrase": "牧童横牛背，短笛信口吹"
 },
 {
  "title": "遊子吟",
  "author": "孟郊",
  "dynasty": "唐",
  "grade": "五年級",
  "paragraphs": [
   "慈母手中線，",
   "遊子身上衣。",
   "臨行密密縫，",
   "意恐遲遲歸。",
   "誰言寸草心，",
   "報得三春暉。"
  ],
  "paraphrase": "母爱如寸草春晖"
 },
 {
  "title": "鳥鳴澗",
  "author": "王維",
  "dynasty": "唐",
  "grade": "五年級",
  "paragraphs": [
   "人閒桂花落，夜靜春山空。",
   "月出驚山鳥，時鳴春澗中。"
  ],
  "paraphrase": "春山月出鸟惊"
 },
 {
  "title": "從軍行",
  "author": "王昌齡",
  "dynasty": "唐",
  "grade": "五年級",
  "paragraphs": [
   "青海長雲暗雪山，",
   "孤城遙望雁門關。",
   "黃沙百戰穿金甲，",
   "不破樓蘭終不還。"
  ],
  "paraphrase": "黄沙百战穿金甲"
 },
 {
  "title": "秋夜將曉出籬門迎涼有感",
  "author": "陸游",
  "dynasty": "宋",
  "grade": "五年級",
  "paragraphs": [
   "三萬里河東入海，",
   "五千仞嶽上摩天。",
   "遺民泪盡胡塵裏，",
   "南望王師又一年。"
  ],
  "paraphrase": "盼王师收失地"
 },
 {
  "title": "聞官軍收河南河北",
  "author": "杜甫",
  "dynasty": "唐",
  "grade": "五年級",
  "paragraphs": [
   "劍外忽傳收薊北，",
   "初聞涕淚滿衣裳。",
   "卻看妻子愁何在，",
   "即從巴峽穿巫峽，",
   "便下襄陽向洛陽。"
  ],
  "paraphrase": "喜极而狂，欲还故乡"
 },
 {
  "title": "涼州詞(黃河遠上)",
  "author": "王之渙",
  "dynasty": "唐",
  "grade": "五年級",
  "paragraphs": [
   "黃河遠上白雲間，",
   "一片孤城萬仞山。",
   "羌笛何須怨楊柳，",
   "春光不度玉門關。"
  ],
  "paraphrase": "羌笛怨杨柳"
 },
 {
  "title": "黃鶴樓送孟浩然之廣陵",
  "author": "李白",
  "dynasty": "唐",
  "grade": "五年級",
  "paragraphs": [
   "故人西辭黃鶴樓，",
   "煙花三月下揚州。",
   "孤帆遠影碧山盡，",
   "唯見長江天際流。"
  ],
  "paraphrase": "烟花三月下扬州"
 },
 {
  "title": "鄉村四月",
  "author": "翁卷",
  "dynasty": "宋",
  "grade": "五年級",
  "paragraphs": [
   "綠遍山原白滿川，",
   "子規聲裏雨如煙。",
   "鄉村四月閑人少，",
   "纔了蠶桑又插田。"
  ],
  "paraphrase": "乡村四月闲人少"
 },
 {
  "title": "宿建德江",
  "author": "孟浩然",
  "dynasty": "唐",
  "grade": "六年級",
  "paragraphs": [
   "移舟泊煙渚，",
   "日暮客愁新。",
   "野曠天低樹，",
   "江清月近人。"
  ],
  "paraphrase": "暮宿客愁，江清月近人"
 },
 {
  "title": "六月二十七日望湖樓醉書",
  "author": "蘇軾",
  "dynasty": "宋",
  "grade": "六年級",
  "paragraphs": [
   "黑雲翻墨未遮山，",
   "白雨跳珠亂入船。",
   "卷地風來忽吹散，",
   "望湖樓下水如天。"
  ],
  "paraphrase": "西湖骤雨急晴"
 },
 {
  "title": "西江月·夜行黃沙道中",
  "author": "辛棄疾",
  "dynasty": "宋",
  "grade": "六年級",
  "paragraphs": [
   "明月別枝驚鵲，清風半夜鳴蟬。",
   "稻花香裡說豐年，聽取蛙聲一片。",
   "七八個星天外，兩三點雨山前。",
   "舊時茅店社林邊，路轉溪橋忽見。"
  ],
  "paraphrase": "稻香蛙声，闲适恬淡"
 },
 {
  "title": "過故人莊",
  "author": "孟浩然",
  "dynasty": "唐",
  "grade": "六年級",
  "paragraphs": [
   "故人具雞黍，",
   "邀我至田家。",
   "綠樹村邊合，",
   "青山郭外斜。",
   "開筵面場圃，",
   "把酒話桑麻。",
   "待到重陽日，",
   "還來就菊花。"
  ],
  "paraphrase": "田家饮酒，重阳再约"
 },
 {
  "title": "春日",
  "author": "朱熹",
  "dynasty": "宋",
  "grade": "六年級",
  "paragraphs": [
   "勝日尋芳泗水濱，",
   "無邊光景一時新。",
   "等閑識得東風面，",
   "萬紫千紅總是春。"
  ],
  "paraphrase": "东风面万紫千红"
 },
 {
  "title": "回鄉偶書",
  "author": "賀知章",
  "dynasty": "唐",
  "grade": "六年級",
  "paragraphs": [
   "少小離家老大回，鄉音無改鬢毛衰。",
   "兒童相見不相識，笑問客從何處來。"
  ],
  "paraphrase": "乡音无改鬓毛衰"
 },
 {
  "title": "浪淘沙(其一)",
  "author": "劉禹錫",
  "dynasty": "唐",
  "grade": "六年級",
  "paragraphs": [
   "九曲黃河萬里沙，浪淘風簸自天涯。",
   "如今直上銀河去，同到牽牛織女家。"
  ],
  "paraphrase": "直上银河牵牛织女"
 },
 {
  "title": "江南春",
  "author": "杜牧",
  "dynasty": "唐",
  "grade": "六年級",
  "paragraphs": [
   "千里鶯啼綠映紅，",
   "水村山郭酒旗風。",
   "南朝四百八十寺，",
   "多少樓臺煙雨中。"
  ],
  "paraphrase": "南朝寺院烟雨中"
 },
 {
  "title": "書湖陰先生壁",
  "author": "王安石",
  "dynasty": "宋",
  "grade": "六年級",
  "paragraphs": [
   "茅簷長掃淨無苔，花木成畦手自栽。",
   "一水護田將綠繞，兩山排闥送青來。"
  ],
  "paraphrase": "护田排闼，山水有情"
 },
 {
  "title": "寒食",
  "author": "韓翃",
  "dynasty": "唐",
  "grade": "六年級",
  "paragraphs": [
   "春城無處不飛花，",
   "寒食東風御柳斜。",
   "日暮漢宮傳蠟燭，",
   "輕煙散入五侯家。"
  ],
  "paraphrase": "寒食传烛，轻烟入侯家"
 },
 {
  "title": "迢迢牽牛星",
  "author": "古詩十九首",
  "dynasty": "漢",
  "grade": "六年級",
  "paragraphs": [
   "迢迢牽牛星，皎皎河漢女。",
   "纖纖擢素手，札札弄機杼。",
   "終日不成章，泣涕零如雨。",
   "河漢清且淺，相去復幾許。",
   "盈盈一水間，脈脈不得語。"
  ],
  "paraphrase": "牛郎织女，脉脉不得语"
 },
 {
  "title": "十五夜望月",
  "author": "王建",
  "dynasty": "唐",
  "grade": "六年級",
  "paragraphs": [
   "中庭地白樹棲鴉，",
   "冷露無聲濕桂花。",
   "今夜月明人盡望，",
   "不知秋思在誰家。"
  ],
  "paraphrase": "月明秋思落谁家"
 },
 {
  "title": "長歌行",
  "author": "漢樂府",
  "dynasty": "漢",
  "grade": "六年級",
  "paragraphs": [
   "青青園中葵，朝露待日晞。",
   "陽春布德澤，萬物生光輝。",
   "常恐秋節至，焜黃華葉衰。",
   "百川東到海，何時復西歸？",
   "少壯不努力，老大徒傷悲。"
  ],
  "paraphrase": "少壮不努力老大徒伤悲"
 },
 {
  "title": "馬詩(其五)",
  "author": "李賀",
  "dynasty": "唐",
  "grade": "六年級",
  "paragraphs": [
   "大漠沙如雪，",
   "燕山月似钩。",
   "何当金络脑，",
   "快走踏清秋。"
  ],
  "paraphrase": "骏马盼金络脑"
 },
 {
  "title": "石灰吟",
  "author": "于謙",
  "dynasty": "明",
  "grade": "六年級",
  "paragraphs": [
   "千錘萬鑿出深山，烈火焚燒若等閒。",
   "粉骨碎身渾不怕，要留清白在人間。"
  ],
  "paraphrase": "要留清白在人间"
 },
 {
  "title": "竹石",
  "author": "鄭燮",
  "dynasty": "清",
  "grade": "六年級",
  "paragraphs": [
   "咬定青山不放鬆，立根原在破巖中。",
   "千磨萬擊還堅勁，任爾東西南北風。"
  ],
  "paraphrase": "立根破岩，任尔东西南北风"
 },
 {
  "title": "采薇(節選)",
  "author": "詩經",
  "dynasty": "先秦",
  "grade": "六年級",
  "paragraphs": [
   "昔我往矣，楊柳依依。",
   "今我來思，雨雪霏霏。",
   "行道遲遲，載渴載饑。",
   "我心傷悲，莫知我哀！"
  ],
  "paraphrase": "杨柳依依雨雪霏霏"
 },
 {
  "title": "送元二使安西",
  "author": "王維",
  "dynasty": "唐",
  "grade": "六年級",
  "paragraphs": [
   "渭城朝雨浥輕塵，",
   "客舍青青楊柳春。",
   "勸君更盡一杯酒，",
   "西出陽關無故人。"
  ],
  "paraphrase": "劝君更尽一杯酒"
 },
 {
  "title": "春夜喜雨",
  "author": "杜甫",
  "dynasty": "唐",
  "grade": "六年級",
  "paragraphs": [
   "好雨知時節，",
   "當春乃發生。",
   "隨風潛入夜，",
   "潤物細無聲。",
   "野徑雲俱黑，",
   "江船火獨明。",
   "曉看紅濕處，",
   "花重錦官城。"
  ],
  "paraphrase": "润物细无声"
 },
 {
  "title": "早春呈水部張十八員外",
  "author": "韓愈",
  "dynasty": "唐",
  "grade": "六年級",
  "paragraphs": [
   "天街小雨潤如酥，",
   "草色遙看近却無。",
   "最是一年春好處，",
   "絕勝煙柳滿皇都。"
  ],
  "paraphrase": "草色遥看近却无"
 },
 {
  "title": "江上漁者",
  "author": "范仲淹",
  "dynasty": "宋",
  "grade": "六年級",
  "paragraphs": [
   "江上往來人，",
   "但愛鱸魚美。",
   "君看一葉舟，",
   "出沒風波裏。"
  ],
  "paraphrase": "君看一叶舟出没风波"
 },
 {
  "title": "泊船瓜洲",
  "author": "王安石",
  "dynasty": "宋",
  "grade": "六年級",
  "paragraphs": [
   "京口瓜洲一水間，",
   "鍾山祇隔數重山。",
   "春風自綠江南岸，",
   "明月何時照我還。"
  ],
  "paraphrase": "春风又绿江南岸"
 },
 {
  "title": "遊園不值",
  "author": "葉紹翁",
  "dynasty": "宋",
  "grade": "六年級",
  "paragraphs": [
   "應憐屐齒印蒼苔，小扣柴扉久不開。",
   "春色滿園關不住，一枝紅杏出牆來。"
  ],
  "paraphrase": "红杏出墙，春色关不住"
 },
 {
  "title": "卜算子·送鮑浩然之浙東",
  "author": "王觀",
  "dynasty": "宋",
  "grade": "六年級",
  "paragraphs": [
   "水是眼波橫，山是眉峰聚。",
   "欲問行人去那邊？眉眼盈盈處。",
   "才始送春歸，又送君歸去。",
   "若到江南趕上春，千萬和春住。"
  ],
  "paraphrase": "眉眼盈盈，千万和春住"
 },
 {
  "title": "浣溪沙(游蘄水清泉寺)",
  "author": "蘇軾",
  "dynasty": "宋",
  "grade": "六年級",
  "paragraphs": [
   "山下蘭芽短浸溪，松間沙路淨無泥，瀟瀟暮雨子規啼。",
   "誰道人生無再少？門前流水尚能西！休將白髮唱黃雞。"
  ],
  "paraphrase": "休将白发唱黄鸡"
 },
 {
  "title": "清平樂(春歸何處)",
  "author": "黃庭堅",
  "dynasty": "宋",
  "grade": "六年級",
  "paragraphs": [
   "春歸何處？寂寞無行路。",
   "若有人知春去處，喚取歸來同住。",
   "春無蹤跡誰知？除非問取黃鸝。",
   "百囀無人能解，因風飛過薔薇。"
  ],
  "paraphrase": "百啭无人解，因风飞过蔷薇"
 }
]